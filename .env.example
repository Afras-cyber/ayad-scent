# AYAD Scent Lab - environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# --- Site / public ---
NEXT_PUBLIC_SITE_URL=https://ayadscentlab.com
NEXT_PUBLIC_SITE_NAME=AYAD

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for older env naming; prefer PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# --- Auth (admin / NextAuth) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Legacy NextAuth names still referenced by some code paths
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- WhatsApp ---
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- WhatsApp Cloud API (optional, for notifications) ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=

# --- Email (optional, legacy/transactional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Storage (legacy S3; migrate to Supabase Storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# --- Legacy database (to be removed during Supabase migration) ---
MONGODB_URI=

# --- Misc ---
NODE_ENV=development
